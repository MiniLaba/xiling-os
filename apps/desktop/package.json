{
  "name": "@xiling/desktop",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "pnpm build && electron dist/main.js",
    "test:foundation": "pnpm build && node --test dist/core/*.test.js dist/windowing/*.test.js",
    "smoke": "pnpm test:foundation && node scripts/smoke.mjs && node scripts/container-independence.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@types/node": "22.19.19",
    "electron": "44.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
