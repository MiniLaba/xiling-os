{
  "name": "@xiling/desktop",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron dist/main.js",
    "test:foundation": "pnpm build && node --test dist/core/*.test.js",
    "smoke": "pnpm test:foundation && node scripts/smoke.mjs && node scripts/container-independence.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "electron": "44.0.0",
    "typescript": "5.9.3"
  }
}
