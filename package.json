{
  "name": "xiling-os",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "predev": "pnpm -r --filter \"!@xiling/server\" --filter \"!@xiling/web\" build",
    "dev": "pnpm --parallel --filter \"@xiling/*\" dev",
    "start": "pnpm build && node scripts/start.mjs",
    "start:no-browser": "pnpm build && node scripts/start.mjs --no-browser",
    "test": "pnpm -r --filter \"!@xiling/server\" --filter \"!@xiling/web\" build && vitest run",
    "typecheck": "pnpm -r --filter \"!@xiling/server\" --filter \"!@xiling/web\" build && pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs",
    "smoke:web": "pnpm --filter @xiling/web build",
    "smoke:runner": "python3 services/runner/smoke.py",
    "compliance": "node scripts/compliance.mjs",
    "sbom:generate": "node scripts/compliance.mjs --write-sbom",
    "docs:check": "node scripts/design-doc-check.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "architecture": "node scripts/architecture-check.mjs && pnpm docs:check",
    "pi:compat": "node scripts/pi-compatibility-check.mjs && pnpm --filter @xiling/pi-runtime typecheck && pnpm exec vitest run packages/pi-runtime/src/index.test.ts packages/pi-runtime/src/harness-spike.test.ts",
    "check": "pnpm architecture && pnpm pi:compat && pnpm typecheck && pnpm test && pnpm smoke"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
